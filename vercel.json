{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/trigger",
      "schedule": "15 14 * * *"
    }
  ],
  "functions": {
    "api/trigger.py": {
      "maxDuration": 300,
      "memory": 1024
    },
    "api/health.py": {
      "maxDuration": 15,
      "memory": 256
    }
  }
}
