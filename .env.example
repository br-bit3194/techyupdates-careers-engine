# Authentication for Vercel Cron and Webhook triggers (Generate a random 32-character string)
CRON_SECRET=your_random_32_character_secret_here

# Google AI Studio API Key
GEMINI_API_KEY=AIzaSy...

# Gemini Model Name (defaults to gemini-3.5-flash with automatic gemini-2.5-flash fallback)
GEMINI_MODEL=gemini-3.5-flash

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Telegram Community Channel or Group ID (e.g. -1001234567890)
TELEGRAM_COMMUNITY_CHANNEL_ID=-1001234567890
